# Caddy tự cấp & gia hạn SSL (Let's Encrypt) cho domain.
# {$SITE_DOMAIN} lấy từ biến môi trường trong docker-compose.

{$SITE_DOMAIN} {
	encode gzip

	# HLS từ media server (OBS → MediaMTX). /hls/live/index.m3u8 → mediamtx /live/index.m3u8
	# MediaMTX chống hotlink bằng 302 + cookie, redirect về path tuyệt đối (mất /hls);
	# gắn lại tiền tố /hls vào header Location để redirect chạy đúng qua proxy.
	handle_path /hls/* {
		reverse_proxy mediamtx:8888 {
			header_down Location ^/ /hls/
		}
	}

	# WebRTC/WHEP signaling (OBS → MediaMTX, độ trễ ~0.5s). Media chạy UDP trực tiếp cổng 8189.
	handle_path /whep/* {
		reverse_proxy mediamtx:8889
	}

	handle {
		reverse_proxy server:4000
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
